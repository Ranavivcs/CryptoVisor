// Data model for the AI Crypto Advisor.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  preferences   Preferences?
  dailyInsights DailyInsight[]
  feedback      Feedback[]
}

enum InvestorType {
  HODLER
  DAY_TRADER
  NFT_COLLECTOR
  DEFI_EXPLORER
  NEWCOMER
}

enum ContentType {
  MARKET_NEWS
  CHARTS
  SOCIAL
  FUN
}

/// Onboarding answers. A user has finished onboarding when this row exists.
model Preferences {
  id           String        @id @default(cuid())
  userId       String        @unique
  /// CoinGecko coin ids, e.g. "bitcoin", "ethereum".
  assets       String[]
  investorType InvestorType
  contentTypes ContentType[]
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One AI insight per user per day: makes "of the day" literal and caps LLM calls.
model DailyInsight {
  id        String   @id @default(cuid())
  userId    String
  /// Calendar day in UTC, stored as a date with no time part.
  day       DateTime @db.Date
  text      String
  /// Which model produced the text ("fallback" when the LLM call failed).
  model     String
  /// The exact prompt sent, kept for future training / evaluation.
  prompt    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

enum Section {
  NEWS
  PRICES
  INSIGHT
  MEME
}

/// A thumbs up/down on one item the user saw. Re-voting updates the same row.
model Feedback {
  id              String   @id @default(cuid())
  userId          String
  section         Section
  /// Stable id of the item within its section (news id, coin id, insight id, meme id).
  itemId          String
  /// +1 (up) or -1 (down).
  vote            Int
  /// Exactly what the user saw plus their preferences at that moment: the training example.
  contentSnapshot Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section, itemId])
  @@index([section, vote])
}
