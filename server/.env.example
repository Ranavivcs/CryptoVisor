# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Local Docker Postgres (see docker-compose.yml at the repo root). In production: the Neon URL.
DATABASE_URL=postgresql://moveo:moveo@localhost:5433/moveo
# Any long random string, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Optional external API keys. Without them, the dashboard uses built-in fallbacks (marked "Sample").
# Free key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Free developer key: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
# Optional CoinGecko demo key (higher rate limit). Works without one.
COINGECKO_API_KEY=
# Comma-separated free OpenRouter models, tried in order. Has a sensible default.
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
